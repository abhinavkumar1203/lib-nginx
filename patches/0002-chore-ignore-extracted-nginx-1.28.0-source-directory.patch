-static ngx_int_t
-ngx_http_fastcgi_process_header(ngx_http_request_t *r)
-{
-    u_char                         *p, *msg, *start, *last,
-                                   *part_start, *part_end;
-    size_t                          size;
-    ngx_str_t                      *status_line, *pattern;
