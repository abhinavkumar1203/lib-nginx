-static ngx_int_t
-ngx_http_uwsgi_create_request(ngx_http_request_t *r)
-{
-    u_char                        ch, sep, *lowcase_key;
-    size_t                        key_len, val_len, len, allocated;
-    ngx_uint_t                    i, n, hash, skip_empty, header_params;
