-                ngx_destroy_pool(ctx->pool);
-
-                if (timer == 0) {
-                    ngx_mail_auth_http_init(s);
-                    return;
-                }
-
-                ngx_add_timer(s->connection->read, (ngx_msec_t) (timer * 1000));
-
-                s->connection->read->handler = ngx_mail_auth_sleep_handler;
-
-                return;
-            }
