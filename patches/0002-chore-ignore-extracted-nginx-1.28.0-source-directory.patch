-    uscf->peer.init_upstream = ngx_stream_upstream_init_random;
-
-    uscf->flags = NGX_STREAM_UPSTREAM_CREATE
-                  |NGX_STREAM_UPSTREAM_MODIFY
-                  |NGX_STREAM_UPSTREAM_WEIGHT
