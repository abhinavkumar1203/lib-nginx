-                              "AcceptEx() %V failed", &ls->addr_text);
-
-                ngx_close_posted_connection(c);
-                return NGX_ERROR;
-            }
-        }
-    }
-
-    return NGX_OK;
-}
-
-
-static void
-ngx_close_posted_connection(ngx_connection_t *c)
-{
-    ngx_socket_t  fd;
-
-    ngx_free_connection(c);
-
-    fd = c->fd;
-    c->fd = (ngx_socket_t) -1;
-
-    if (ngx_close_socket(fd) == -1) {
