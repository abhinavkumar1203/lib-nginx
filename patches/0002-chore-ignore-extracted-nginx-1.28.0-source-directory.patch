-                if (n != NGX_ERROR) {
-                    ctx->sleep = n;
-                }
-
-                continue;
-            }
-
-            if (len == sizeof("Auth-Error-Code") - 1
-                && ngx_strncasecmp(ctx->header_name_start,
-                                   (u_char *) "Auth-Error-Code",
-                                   sizeof("Auth-Error-Code") - 1)
-                   == 0)
-            {
-                ctx->errcode.len = ctx->header_end - ctx->header_start;
