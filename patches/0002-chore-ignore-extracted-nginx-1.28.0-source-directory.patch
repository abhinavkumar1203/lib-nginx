-
-    for (i = 0; i < n; i++) {
-        cipher = SSL_CIPHER_find(c->ssl->connection, ciphers + i * bytes);
-
-        if (cipher) {
-            len += ngx_strlen(SSL_CIPHER_get_name(cipher));
-
-        } else {
-            len += sizeof("0x") - 1 + bytes * (sizeof("00") - 1);
