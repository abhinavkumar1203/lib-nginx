-{
-    v->len = name->len + sizeof("=00001111222233334444555566667777") - 1;
-    v->data = ngx_pnalloc(r->pool, v->len);
-    if (v->data == NULL) {
-        return NGX_ERROR;
-    }
-
-    v->valid = 1;
-    v->no_cacheable = 0;
-    v->not_found = 0;
-
-    ngx_sprintf(v->data, "%V=%08XD%08XD%08XD%08XD",
-                name, uid[0], uid[1], uid[2], uid[3]);
-
-    return NGX_OK;
-}
