-    if (clcf->tcp_nodelay) {
-
-        if (ngx_tcp_nodelay(c) != NGX_OK) {
-            ngx_http_upstream_finalize_request(r, u, NGX_ERROR);
-            return;
-        }
-
-        if (ngx_tcp_nodelay(u->peer.connection) != NGX_OK) {
