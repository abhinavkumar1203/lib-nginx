-            return NGX_CHAIN_ERROR;
-        }
-
-        ngx_log_debug2(NGX_LOG_DEBUG_EVENT, c->log, 0,
-                       "sendfilev: %z %z", n, sent);
-
-        c->sent += sent;
-
-        in = ngx_chain_update_sent(in, sent);
-
-        if (eintr) {
-            send = prev_send + sent;
-            continue;
-        }
-
-        if (send - prev_send != (off_t) sent) {
-            wev->ready = 0;
-            return in;
-        }
-
-        if (send >= limit || in == NULL) {
-            return in;
-        }
-    }
