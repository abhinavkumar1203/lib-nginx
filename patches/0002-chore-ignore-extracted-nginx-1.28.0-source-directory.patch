-{
-    if (err == NGX_EACCES) {
-        ngx_log_error(NGX_LOG_ERR, r->connection->log, err,
-                      "\"%s\" is forbidden", file);
-
-        return NGX_HTTP_FORBIDDEN;
-    }
-
-    if (clcf->log_not_found) {
-        ngx_log_error(NGX_LOG_ERR, r->connection->log, err,
