-            u.url.len -= 7;
-            u.url.data += 7;
-
-        } else {
-            ngx_log_error(NGX_LOG_EMERG, cf->log, 0,
-                          "invalid URL prefix in OCSP responder \"%V\" "
-                          "in \"ssl_ocsp_responder\"", &u.url);
