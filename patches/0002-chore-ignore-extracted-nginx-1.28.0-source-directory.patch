-static void
-ngx_ssl_ticket_keys_cleanup(void *data)
-{
-    ngx_array_t  *keys = data;
-
-    ngx_explicit_memzero(keys->elts,
-                         keys->nelts * sizeof(ngx_ssl_ticket_key_t));
-}
