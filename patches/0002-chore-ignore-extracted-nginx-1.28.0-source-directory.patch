-    ngx_log_debug2(NGX_LOG_DEBUG_HTTP, c->log, 0,
-                   "http3 parse field ri done %s%ui]",
-                   st->dynamic ? "dynamic[-" : "static[", st->index);
-
-    if (st->dynamic) {
-        st->index = st->base - st->index - 1;
-    }
-
-    rc = ngx_http_v3_parse_lookup(c, st->dynamic, st->index, &st->name,
