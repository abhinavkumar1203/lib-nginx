-    ngx_http_upstream_srv_conf_t  *uscf = conf;
-
-    ngx_str_t  *value;
-
-    if (uscf->resolver) {
-        return "is duplicate";
-    }
-
-    value = cf->args->elts;
-
-    uscf->resolver = ngx_resolver_create(cf, &value[1], cf->args->nelts - 1);
-    if (uscf->resolver == NULL) {
-        return NGX_CONF_ERROR;
