-            ngx_close_posted_connection(c);
-            return NGX_ERROR;
-        }
-
-        *log = ls->log;
-        c->log = log;
-
-        c->recv = ngx_recv;
-        c->send = ngx_send;
-        c->recv_chain = ngx_recv_chain;
-        c->send_chain = ngx_send_chain;
-
-        c->listening = ls;
-
-        rev = c->read;
-        wev = c->write;
-
