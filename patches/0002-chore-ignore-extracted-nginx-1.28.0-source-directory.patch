-static size_t
-ngx_quic_compat_create_header(ngx_quic_compat_record_t *rec, u_char *out,
-    ngx_uint_t plain)
-{
-    u_char  type;
-    size_t  len;
-
-    len = rec->payload.len;
-
-    if (plain) {
-        type = rec->type;
-
-    } else {
-        type = SSL3_RT_APPLICATION_DATA;
-        len += NGX_QUIC_TAG_LEN;
-    }
-
-    out[0] = type;
-    out[1] = 0x03;
-    out[2] = 0x03;
-    out[3] = (len >> 8);
-    out[4] = len;
-
-    return 5;
-}
