-    ngx_quic_build_int(&p, ack->range_count);
-    ngx_quic_build_int(&p, ack->first_range);
-
-    while (ranges) {
-        b = ranges->buf;
-        p = ngx_cpymem(p, b->pos, b->last - b->pos);
-        ranges = ranges->next;
-    }
-
-    return p - start;
