-                                        sizeof(ngx_http_fastcgi_split_part_t));
-            if (f->split_parts == NULL) {
-                return NGX_ERROR;
-            }
-        }
-
-        part = ngx_array_push(f->split_parts);
-        if (part == NULL) {
-            return NGX_ERROR;
-        }
-
-        part->start = part_start;
-        part->end = part_end;
-
-        if (u->buffer.pos < u->buffer.last) {
-            continue;
-        }
-
-        return NGX_AGAIN;
-    }
-}
