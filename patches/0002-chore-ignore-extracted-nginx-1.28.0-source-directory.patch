-static int ngx_libc_cdecl
-ngx_http_map_cmp_dns_wildcards(const void *one, const void *two)
-{
-    ngx_hash_key_t  *first, *second;
-
-    first = (ngx_hash_key_t *) one;
-    second = (ngx_hash_key_t *) two;
