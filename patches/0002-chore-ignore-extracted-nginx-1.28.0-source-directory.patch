-static char *
-ngx_stream_ssl_alpn(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
-{
-#ifdef TLSEXT_TYPE_application_layer_protocol_negotiation
-
-    ngx_stream_ssl_srv_conf_t  *sscf = conf;
-
-    u_char      *p;
-    size_t       len;
