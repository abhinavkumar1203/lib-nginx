-
-    for (n = 0; n < ngx_last_process; n++) {
-
-        ngx_log_debug5(NGX_LOG_DEBUG_CORE, cycle->log, 0,
-                       "process: %d %P %p e:%d j:%d",
-                       n,
-                       ngx_processes[n].pid,
-                       ngx_processes[n].handle,
-                       ngx_processes[n].exiting,
-                       ngx_processes[n].just_spawn);
