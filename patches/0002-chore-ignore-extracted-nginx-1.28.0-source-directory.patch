-static ngx_int_t
-ngx_ssl_check_name(ngx_str_t *name, ASN1_STRING *pattern)
-{
-    u_char  *s, *p, *end;
-    size_t   slen, plen;
-
-    s = name->data;
-    slen = name->len;
-
-    p = ASN1_STRING_data(pattern);
-    plen = ASN1_STRING_length(pattern);
-
-    if (slen == plen && ngx_strncasecmp(s, p, plen) == 0) {
-        return NGX_OK;
-    }
-
-    if (plen > 2 && p[0] == '*' && p[1] == '.') {
-        plen -= 1;
-        p += 1;
-
-        end = s + slen;
-        s = ngx_strlchr(s, end, '.');
-
-        if (s == NULL) {
-            return NGX_ERROR;
-        }
-
-        slen = end - s;
-
-        if (plen == slen && ngx_strncasecmp(s, p, plen) == 0) {
-            return NGX_OK;
-        }
-    }
-
-    return NGX_ERROR;
-}
-
-#endif
