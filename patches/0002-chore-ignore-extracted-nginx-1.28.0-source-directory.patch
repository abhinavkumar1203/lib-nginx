-
-    ngx_rbtree_delete(rbtree, &cn->node);
-
-    if (!ngx_queue_empty(&cn->queue)) {
-        ngx_queue_remove(&cn->queue);
-
-        ngx_log_debug1(NGX_LOG_DEBUG_CORE, ngx_cycle->log, 0,
-                       "delete cached ssl object: %s", cn->id.data);
-
-        ngx_free(cn);
-    }
-}
