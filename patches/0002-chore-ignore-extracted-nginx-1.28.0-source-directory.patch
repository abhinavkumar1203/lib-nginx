-    ocsp = c->ssl->ocsp;
-    if (ocsp == NULL) {
-        return;
-    }
-
-    if (ocsp->ctx) {
-        ngx_ssl_ocsp_done(ocsp->ctx);
-        ocsp->ctx = NULL;
-    }
-
-    if (ocsp->certs) {
-        sk_X509_pop_free(ocsp->certs, X509_free);
-        ocsp->certs = NULL;
-    }
