-    case NGX_HTTP_DELETE:
-
-        return ngx_http_dav_delete_handler(r);
-
-    case NGX_HTTP_MKCOL:
-
-        return ngx_http_dav_mkcol_handler(r, dlcf);
-
-    case NGX_HTTP_COPY:
-
-        return ngx_http_dav_copy_move_handler(r);
-
-    case NGX_HTTP_MOVE:
