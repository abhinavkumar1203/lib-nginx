-
-                if (fd == cl->buf->file->fd && fprev == cl->buf->file_pos) {
-                    sfv->sfv_len += (size_t) size;
-
-                } else {
-                    if (nsfv == NGX_SENDFILEVECS) {
-                        break;
-                    }
-
-                    sfv = &sfvs[nsfv++];
-
-                    fd = cl->buf->file->fd;
