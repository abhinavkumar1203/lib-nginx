-
-static ngx_inline void
-ngx_http_limit_conn_cleanup_all(ngx_pool_t *pool)
-{
-    ngx_pool_cleanup_t  *cln;
-
-    cln = pool->cleanup;
-
-    while (cln && cln->handler == ngx_http_limit_conn_cleanup) {
-        ngx_http_limit_conn_cleanup(cln->data);
-        cln = cln->next;
-    }
-
-    pool->cleanup = cln;
-}
