-    ngx_md5_final(md5_buf, &md5);
-
-    if (ngx_memcmp(hash_buf, md5_buf, 16) != 0) {
-        goto not_found;
-    }
-
-    v->data = (u_char *) ((expires && expires < ngx_time()) ? "0" : "1");
-    v->len = 1;
-    v->valid = 1;
-    v->no_cacheable = 0;
-    v->not_found = 0;
-
-    return NGX_OK;
-
-not_found:
-
-    v->not_found = 1;
-
-    return NGX_OK;
