-/*
- * ngx_utf8_decode() decodes two and more bytes UTF sequences only
- * the return values:
- *    0x80 - 0x10ffff         valid character
- *    0x110000 - 0xfffffffd   invalid sequence
- *    0xfffffffe              incomplete sequence
- *    0xffffffff              error
- */
-
-uint32_t
-ngx_utf8_decode(u_char **p, size_t n)
-{
-    size_t    len;
-    uint32_t  u, i, valid;
-
-    u = **p;
-
-    if (u >= 0xf8) {
-
-        (*p)++;
-        return 0xffffffff;
-
-    } else if (u >= 0xf0) {
-
-        u &= 0x07;
-        valid = 0xffff;
-        len = 3;
-
-    } else if (u >= 0xe0) {
-
-        u &= 0x0f;
-        valid = 0x7ff;
-        len = 2;
-
-    } else if (u >= 0xc2) {
-
-        u &= 0x1f;
-        valid = 0x7f;
-        len = 1;
-
-    } else {
-        (*p)++;
-        return 0xffffffff;
-    }
-
-    if (n - 1 < len) {
-        return 0xfffffffe;
-    }
-
-    (*p)++;
-
-    while (len) {
-        i = *(*p)++;
-
-        if (i < 0x80) {
-            return 0xffffffff;
-        }
-
-        u = (u << 6) | (i & 0x3f);
-
-        len--;
-    }
-
-    if (u > valid) {
-        return u;
-    }
-
-    return 0xffffffff;
-}
