-
-        if (b->last - b->pos < (ssize_t) ctx->rest) {
-            last = b->last;
-
-        } else {
-            last = b->pos + ctx->rest;
-        }
-
-        for (p = b->pos; p < last; p++) {
-            ch = *p;
-
-#if 0
-            ngx_log_debug2(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
-                           "grpc header byte: %02Xd s:%d", ch, state);
-#endif
-
-            /*
-             * headers frame:
-             *
-             * +---------------+
-             * |Pad Length? (8)|
-             * +-+-------------+----------------------------------------------+
-             * |E|                 Stream Dependency? (31)                    |
-             * +-+-------------+----------------------------------------------+
-             * |  Weight? (8)  |
-             * +-+-------------+----------------------------------------------+
-             * |                   Header Block Fragment (*)                ...
-             * +--------------------------------------------------------------+
-             * |                           Padding (*)                      ...
-             * +--------------------------------------------------------------+
