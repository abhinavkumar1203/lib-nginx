-
-    t = localtime(&s);
-    *tm = *t;
-
-#endif
-}
-
-
-void
-ngx_libc_gmtime(time_t s, struct tm *tm)
-{
-#if (NGX_HAVE_LOCALTIME_R)
-    (void) gmtime_r(&s, tm);
-
-#else
-    struct tm  *t;
-
-    t = gmtime(&s);
-    *tm = *t;
-
-#endif
-}
