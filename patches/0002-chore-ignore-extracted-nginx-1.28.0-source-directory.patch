-static ngx_int_t
-ngx_http_grpc_parse_fragment(ngx_http_request_t *r, ngx_http_grpc_ctx_t *ctx,
-    ngx_buf_t *b)
-{
-    u_char      ch, *p, *last;
-    size_t      size;
-    ngx_uint_t  index, size_update;
-    enum {
-        sw_start = 0,
-        sw_index,
-        sw_name_length,
-        sw_name_length_2,
-        sw_name_length_3,
-        sw_name_length_4,
-        sw_name,
-        sw_name_bytes,
-        sw_value_length,
-        sw_value_length_2,
-        sw_value_length_3,
-        sw_value_length_4,
-        sw_value,
-        sw_value_bytes
