-
-    ngx_log_debug3(NGX_LOG_DEBUG_CORE, r->log, 0,
-                   "resolver nsrvs:%ui cname:%p ttl:%uD",
-                   nsrvs, cname, rn->ttl);
-
-    if (nsrvs) {
-
-        srvs = ngx_resolver_calloc(r, nsrvs * sizeof(ngx_resolver_srv_t));
