-ngx_int_t
-ngx_quic_handle_path_response_frame(ngx_connection_t *c,
-    ngx_quic_path_challenge_frame_t *f)
-{
-    ngx_uint_t              rst;
-    ngx_queue_t            *q;
-    ngx_quic_path_t        *path, *prev;
-    ngx_quic_send_ctx_t    *ctx;
