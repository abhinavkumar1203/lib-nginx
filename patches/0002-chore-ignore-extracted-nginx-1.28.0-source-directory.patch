-ngx_int_t
-ngx_ssl_connection_certificate(ngx_connection_t *c, ngx_pool_t *pool,
-    ngx_str_t *cert, ngx_str_t *key, ngx_ssl_cache_t *cache,
-    ngx_array_t *passwords)
-{
