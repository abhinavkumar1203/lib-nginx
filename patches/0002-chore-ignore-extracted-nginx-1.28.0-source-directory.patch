-
-static ngx_ssl_cache_node_t *
-ngx_ssl_cache_lookup(ngx_ssl_cache_t *cache, ngx_ssl_cache_type_t *type,
-    ngx_ssl_cache_key_t *id, uint32_t hash)
-{
-    ngx_int_t              rc;
-    ngx_rbtree_node_t     *node, *sentinel;
-    ngx_ssl_cache_node_t  *cn;
-
-    node = cache->rbtree.root;
-    sentinel = cache->rbtree.sentinel;
-
-    while (node != sentinel) {
-
-        if (hash < node->key) {
-            node = node->left;
-            continue;
-        }
-
-        if (hash > node->key) {
-            node = node->right;
-            continue;
-        }
-
-        /* hash == node->key */
-
-        cn = (ngx_ssl_cache_node_t *) node;
-
-        if (type < cn->type) {
-            node = node->left;
-            continue;
-        }
-
-        if (type > cn->type) {
-            node = node->right;
-            continue;
-        }
-
-        /* type == cn->type */
-
-        rc = ngx_memn2cmp(id->data, cn->id.data, id->len, cn->id.len);
-
-        if (rc == 0) {
-            return cn;
-        }
-
