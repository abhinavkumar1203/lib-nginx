-    }
-
-    escaped->len = text->len + n * 2;
-
-    p = ngx_pnalloc(pool, escaped->len);
-    if (p == NULL) {
-        return NGX_ERROR;
-    }
-
-    (void) ngx_escape_uri(p, text->data, text->len, NGX_ESCAPE_MAIL_AUTH);
-
-    escaped->data = p;
-
-    return NGX_OK;
