-
-    switch (status) {
-
-    case NGX_HTTP_V2_CANCEL:
-        ngx_log_error(NGX_LOG_INFO, fc->log, 0,
-                      "client canceled stream %ui", h2c->state.sid);
-        break;
-
-    case NGX_HTTP_V2_INTERNAL_ERROR:
