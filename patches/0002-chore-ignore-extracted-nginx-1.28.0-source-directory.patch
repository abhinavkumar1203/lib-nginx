-                state = ssi_quoted_symbol_state;
-
-                /* fall through */
-
-            default:
-                if (ctx->param->value.len == ctx->value_len) {
-                    ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
-                                  "too long \"%V%c...\" value of \"%V\" "
