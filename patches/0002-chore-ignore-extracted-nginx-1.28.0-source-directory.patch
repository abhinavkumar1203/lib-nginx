-    if (code > NGX_RESOLVE_REFUSED) {
-        goto dns_error;
-    }
-
-    if (nqs != 1) {
-        err = "invalid number of questions in DNS response";
-        goto done;
-    }
-
-    i = sizeof(ngx_resolver_hdr_t);
-
-    while (i < (ngx_uint_t) n) {
-
-        if (buf[i] & 0xc0) {
-            err = "unexpected compression pointer in DNS response";
-            goto done;
-        }
-
-        if (buf[i] == '\0') {
-            goto found;
-        }
-
-        i += 1 + buf[i];
-    }
-
