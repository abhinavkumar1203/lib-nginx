-
-    if (r->connection->ssl) {
-
-        if (handler(r->connection, r->pool, &s) != NGX_OK) {
-            return NGX_ERROR;
-        }
-
-        v->len = s.len;
-        v->data = s.data;
-
-        if (v->len) {
-            v->valid = 1;
-            v->no_cacheable = 0;
-            v->not_found = 0;
-
-            return NGX_OK;
-        }
-    }
-
-    v->not_found = 1;
-
-    return NGX_OK;
