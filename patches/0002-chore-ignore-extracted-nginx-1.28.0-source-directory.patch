-static ngx_int_t
-ngx_http_v2_construct_cookie_header(ngx_http_request_t *r)
-{
-    u_char                     *buf, *p, *end;
-    size_t                      len;
-    ngx_str_t                  *vals;
-    ngx_uint_t                  i;
-    ngx_array_t                *cookies;
-    ngx_table_elt_t            *h;
-    ngx_http_header_t          *hh;
-    ngx_http_core_main_conf_t  *cmcf;
