-    struct sockaddr_in   *sin;
-#if (NGX_HAVE_INET6)
-    struct sockaddr_in6  *sin6;
-#endif
-
-    value = cf->args->elts;
-
-    if (rscf->from == NULL) {
-        rscf->from = ngx_array_create(cf->pool, 2,
