-static char *
-ngx_stream_upstream_server(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
-{
-    ngx_stream_upstream_srv_conf_t  *uscf = conf;
-
-    time_t                         fail_timeout;
-    ngx_str_t                     *value, s;
-    ngx_url_t                      u;
