-    of->disable_symlinks = clcf->disable_symlinks;
-
-    if (clcf->disable_symlinks_from == NULL) {
-        return NGX_OK;
-    }
-
-    if (ngx_http_complex_value(r, clcf->disable_symlinks_from, &from)
-        != NGX_OK)
-    {
-        return NGX_ERROR;
-    }
-
-    if (from.len == 0
-        || from.len > path->len
-        || ngx_memcmp(path->data, from.data, from.len) != 0)
-    {
-        return NGX_OK;
-    }
-
-    if (from.len == path->len) {
