-#define SET(n)      (*(uint32_t *) &p[n * 4])
-#define GET(n)      (*(uint32_t *) &p[n * 4])
-
-#else
-
-#define SET(n)                                                                \
-    (block[n] =                                                               \
-    (uint32_t) p[n * 4] |                                                     \
-    ((uint32_t) p[n * 4 + 1] << 8) |                                          \
-    ((uint32_t) p[n * 4 + 2] << 16) |                                         \
-    ((uint32_t) p[n * 4 + 3] << 24))
-
-#define GET(n)      block[n]
-
-#endif
