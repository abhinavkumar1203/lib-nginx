-            } else {
-                ctx->addrs = addrs;
-            }
-
-            next = ctx->next;
-
-            ctx->handler(ctx);
-        }
-
-        if (addrs != NULL) {
-            ngx_resolver_free(r, addrs->sockaddr);
-            ngx_resolver_free(r, addrs);
-        }
-
-        ngx_resolver_free(r, rn->query);
