-static ngx_http_v2_node_t *
-ngx_http_v2_get_node_by_id(ngx_http_v2_connection_t *h2c, ngx_uint_t sid,
-    ngx_uint_t alloc)
-{
-    ngx_uint_t               index;
-    ngx_http_v2_node_t      *node;
-    ngx_http_v2_srv_conf_t  *h2scf;
