-    if (ctx->zstream.avail_out == 0 && rc != Z_STREAM_END) {
-
-        /* zlib wants to output some more gzipped data */
-
-        cl = ngx_alloc_chain_link(r->pool);
-        if (cl == NULL) {
-            return NGX_ERROR;
-        }
-
-        cl->buf = ctx->out_buf;
-        cl->next = NULL;
-        *ctx->last_out = cl;
-        ctx->last_out = &cl->next;
