-        if (ngx_mail_proxy_send_proxy_protocol(s) != NGX_OK) {
-            return;
-        }
-
-        s->proxy->proxy_protocol = 0;
-    }
-
-    if (ngx_handle_write_event(wev, 0) != NGX_OK) {
-        ngx_mail_proxy_internal_server_error(s);
