-        if (ngx_strcmp(value[i].data, "off") == 0) {
-            clcf->disable_symlinks = NGX_DISABLE_SYMLINKS_OFF;
-            continue;
-        }
-
-        if (ngx_strcmp(value[i].data, "if_not_owner") == 0) {
