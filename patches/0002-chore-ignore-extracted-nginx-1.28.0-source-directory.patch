-    q = ngx_queue_head(&ctx->sent);
-    f = ngx_queue_data(q, ngx_quic_frame_t, queue);
-    pkt_thr = (ctx->pnum - f->pnum) / 2;
-
-    if (pkt_thr <= NGX_QUIC_PKT_THR) {
-        return NGX_QUIC_PKT_THR;
