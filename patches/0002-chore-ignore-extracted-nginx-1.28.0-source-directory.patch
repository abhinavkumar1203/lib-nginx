-static ngx_int_t
-ngx_http_grpc_validate_header_name(ngx_http_request_t *r, ngx_str_t *s)
-{
-    u_char      ch;
-    ngx_uint_t  i;
-
-    for (i = 0; i < s->len; i++) {
-        ch = s->data[i];
-
-        if (ch == ':' && i > 0) {
-            return NGX_ERROR;
-        }
-
-        if (ch >= 'A' && ch <= 'Z') {
-            return NGX_ERROR;
-        }
-
-        if (ch <= 0x20 || ch == 0x7f) {
-            return NGX_ERROR;
-        }
-    }
-
-    return NGX_OK;
-}
-
-
-static ngx_int_t
-ngx_http_grpc_validate_header_value(ngx_http_request_t *r, ngx_str_t *s)
-{
-    u_char      ch;
-    ngx_uint_t  i;
-
-    for (i = 0; i < s->len; i++) {
-        ch = s->data[i];
-
-        if (ch == '\0' || ch == CR || ch == LF) {
-            return NGX_ERROR;
-        }
-    }
-
-    return NGX_OK;
-}
