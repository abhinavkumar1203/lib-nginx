-            case '-':
-                state = ssi_comment_end1_state;
-                break;
-
-            default:
-                ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
-                              "unexpected \"%c\" symbol in \"%V\" SSI command",
-                              ch, &ctx->command);
