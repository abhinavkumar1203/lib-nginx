-    while (rev->ready) {
-        n = ngx_recv(c, b->last, b->end - b->last);
-
-        if (n == NGX_AGAIN) {
-            break;
-        }
-
-        if (n == NGX_ERROR || n == 0) {
-            goto failed;
-        }
-
-        b->last += n;
