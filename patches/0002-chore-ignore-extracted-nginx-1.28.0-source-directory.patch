-static void
-ngx_http_perl_eval_anon_sub(pTHX_ ngx_str_t *handler, SV **sv)
-{
-    u_char  *p;
-
-    for (p = handler->data; *p; p++) {
-        if (*p != ' ' && *p != '\t' && *p != CR && *p != LF) {
-            break;
-        }
-    }
