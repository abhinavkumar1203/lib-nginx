-ngx_int_t
-ngx_http_parse_unsafe_uri(ngx_http_request_t *r, ngx_str_t *uri,
-    ngx_str_t *args, ngx_uint_t *flags)
-{
-    u_char      ch, *p, *src, *dst;
-    size_t      len;
-    ngx_uint_t  quoted;
-
-    len = uri->len;
-    p = uri->data;
-    quoted = 0;
-
-    if (len == 0 || p[0] == '?') {
-        goto unsafe;
-    }
-
-    if (p[0] == '.' && len > 1 && p[1] == '.'
-        && (len == 2 || ngx_path_separator(p[2])))
-    {
-        goto unsafe;
-    }
-
-    for ( /* void */ ; len; len--) {
-
-        ch = *p++;
-
-        if (ch == '%') {
-            quoted = 1;
-            continue;
-        }
-
-        if (usual[ch >> 5] & (1U << (ch & 0x1f))) {
-            continue;
-        }
-
-        if (ch == '?') {
-            args->len = len - 1;
-            args->data = p;
-            uri->len -= len;
-
-            break;
-        }
-
-        if (ch == '\0') {
-            goto unsafe;
-        }
-
-        if (ngx_path_separator(ch) && len > 2) {
-
-            /* detect "/../" and "/.." */
-
-            if (p[0] == '.' && p[1] == '.'
-                && (len == 3 || ngx_path_separator(p[2])))
-            {
-                goto unsafe;
-            }
-        }
-    }
-
-    if (quoted) {
-        ngx_log_debug1(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
-                       "escaped URI: \"%V\"", uri);
-
-        src = uri->data;
-
-        dst = ngx_pnalloc(r->pool, uri->len);
-        if (dst == NULL) {
-            return NGX_ERROR;
-        }
-
-        uri->data = dst;
-
-        ngx_unescape_uri(&dst, &src, uri->len, 0);
-
-        uri->len = dst - uri->data;
-
-        ngx_log_debug1(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
-                       "unescaped URI: \"%V\"", uri);
-
-        len = uri->len;
-        p = uri->data;
-
-        if (p[0] == '.' && len > 1 && p[1] == '.'
-            && (len == 2 || ngx_path_separator(p[2])))
-        {
-            goto unsafe;
-        }
-
-        for ( /* void */ ; len; len--) {
-
-            ch = *p++;
-
-            if (ch == '\0') {
-                goto unsafe;
-            }
-
-            if (ngx_path_separator(ch) && len > 2) {
-
-                /* detect "/../" and "/.." */
-
-                if (p[0] == '.' && p[1] == '.'
-                    && (len == 3 || ngx_path_separator(p[2])))
-                {
-                    goto unsafe;
-                }
-            }
-        }
-    }
-
-    return NGX_OK;
-
-unsafe:
-
-    if (*flags & NGX_HTTP_LOG_UNSAFE) {
-        ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
-                      "unsafe URI \"%V\" was detected", uri);
-    }
-
