-
-    if (ctx) {
-        v->len = ctx->expires.len;
-        v->valid = 1;
-        v->no_cacheable = 0;
-        v->not_found = 0;
-        v->data = ctx->expires.data;
-
-    } else {
-        v->not_found = 1;
-    }
-
-    return NGX_OK;
-}
