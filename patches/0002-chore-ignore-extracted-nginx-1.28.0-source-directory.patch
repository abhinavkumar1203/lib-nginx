-                wsabuf->buf = (char *) cl->buf->pos;
-                wsabuf->len = cl->buf->last - cl->buf->pos;
-            }
-
-            prev = cl->buf->last;
-            send += size;
-        }
-
-        sent = 0;
-
-        rc = WSASend(c->fd, vec.elts, vec.nelts, &sent, 0, NULL, NULL);
