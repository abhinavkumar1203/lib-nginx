-                st->state = sw_type;
-            }
-
-            break;
-
-        case sw_skip:
-
-            rc = ngx_http_v3_parse_skip(b, &st->length);
-            if (rc != NGX_DONE) {
-                return rc;
-            }
-
-            st->state = sw_type;
-            break;
-        }
-    }
