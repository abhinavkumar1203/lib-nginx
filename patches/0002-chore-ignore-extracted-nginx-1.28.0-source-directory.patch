-                break;
-
-            case '-':
-                state = ssi_comment_end0_state;
-                break;
-
-            default:
-                ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
-                              "unexpected \"%c\" symbol after \"%V\" value "
-                              "of \"%V\" parameter in \"%V\" SSI command",
-                              ch, &ctx->param->value, &ctx->param->key,
