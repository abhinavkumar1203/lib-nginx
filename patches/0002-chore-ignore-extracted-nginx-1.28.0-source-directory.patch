-
-        /* f->type == NGX_HTTP_FASTCGI_STDOUT */
-
-#if (NGX_HTTP_CACHE)
-
-        if (f->large_stderr && r->cache) {
-            ssize_t                     len;
-            ngx_http_fastcgi_header_t  *fh;
-
-            start = u->buffer.start + r->cache->header_start;
-
-            len = u->buffer.pos - start - 2 * sizeof(ngx_http_fastcgi_header_t);
