-        dst=$(printf "BPF_REG_%d" $dst)
-        src=$(printf "BPF_REG_%d" $src)
-        offset=$(printf "%d" $offset)
-        immedi=$(printf "0x%x" $immedi)
-
-        printf "    { %4s, %11s, %11s, (int16_t) %6s, %10s },\n" $opcode $dst $src $offset $immedi
-    done
-
-cat << END
-};
-
-END
-}
-
-generate_head
-process_relocations
-process_section
-generate_tail
