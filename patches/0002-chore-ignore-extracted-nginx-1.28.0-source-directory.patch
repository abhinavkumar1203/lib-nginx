-ngx_int_t
-ngx_http_read_unbuffered_request_body(ngx_http_request_t *r)
-{
-    ngx_int_t  rc;
-
-#if (NGX_HTTP_V2)
-    if (r->stream) {
-        rc = ngx_http_v2_read_unbuffered_request_body(r);
-
-        if (rc == NGX_OK) {
-            r->reading_body = 0;
-        }
-
-        return rc;
-    }
-#endif
-
-#if (NGX_HTTP_V3)
-    if (r->http_version == NGX_HTTP_VERSION_30) {
-        rc = ngx_http_v3_read_unbuffered_request_body(r);
-
-        if (rc == NGX_OK) {
-            r->reading_body = 0;
