-
-    flcf = ngx_http_get_module_loc_conf(r, ngx_http_fastcgi_module);
-
-    if (ngx_http_complex_value(r, &flcf->cache_key, key) != NGX_OK) {
-        return NGX_ERROR;
-    }
-
-    return NGX_OK;
-}
