-                fh->padding_length = 0;
-                fh->reserved = 0;
-
-            } else {
-                r->cache->header_start += u->buffer.pos - start
-                                          - sizeof(ngx_http_fastcgi_header_t);
-            }
-
-            f->large_stderr = 0;
-        }
-
-#endif
-
-        f->fastcgi_stdout = 1;
-
-        start = u->buffer.pos;
-
-        if (u->buffer.pos + f->length < u->buffer.last) {
-
-            /*
-             * set u->buffer.last to the end of the FastCGI record data
-             * for ngx_http_parse_header_line()
