-            *b->last++ = CR; *b->last++ = LF;
-        }
-    }
-
-#endif
-
-    if (ahcf->header.len) {
-        b->last = ngx_copy(b->last, ahcf->header.data, ahcf->header.len);
-    }
-
-    /* add "\r\n" at the header end */
-    *b->last++ = CR; *b->last++ = LF;
