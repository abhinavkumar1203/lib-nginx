-static void
-ngx_quic_bpf_cleanup(void *data)
-{
-    ngx_quic_bpf_conf_t  *bcf = (ngx_quic_bpf_conf_t *) data;
-
-    ngx_queue_t            *q;
-    ngx_quic_sock_group_t  *grp;
-
-    for (q = ngx_queue_head(&bcf->groups);
-         q != ngx_queue_sentinel(&bcf->groups);
-         q = ngx_queue_next(q))
