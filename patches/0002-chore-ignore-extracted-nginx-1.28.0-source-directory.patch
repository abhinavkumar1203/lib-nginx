-    p = ngx_proxy_protocol_read(c, buf, buf + n);
-
-    if (p == NULL) {
-        ngx_mail_close_connection(c);
-        return;
-    }
-
-    size = p - buf;
-
-    if (c->recv(c, buf, size) != (ssize_t) size) {
-        ngx_mail_close_connection(c);
-        return;
-    }
-
-    if (ngx_mail_realip_handler(s) != NGX_OK) {
-        ngx_mail_close_connection(c);
-        return;
-    }
-
-    ngx_mail_init_session_handler(rev);
-}
