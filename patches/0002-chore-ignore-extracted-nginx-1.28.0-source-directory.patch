-    ngx_stream_upstream_rr_peers_rlock(hp->rrp.peers);
-
-    if (hp->tries > 20 || hp->rrp.peers->number < 2 || hp->key.len == 0) {
-        ngx_stream_upstream_rr_peers_unlock(hp->rrp.peers);
