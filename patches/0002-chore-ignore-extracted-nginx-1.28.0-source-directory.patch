-static u_short *
-ngx_utf8_to_utf16(u_short *utf16, u_char *utf8, size_t *len, size_t reserved)
-{
-    u_char    *p;
-    u_short   *u, *last;
-    uint32_t   n;
-
-    p = utf8;
-    u = utf16;
-    last = utf16 + *len;
-
-    while (u < last) {
-
-        if (*p < 0x80) {
-            *u++ = (u_short) *p;
-
-            if (*p == 0) {
-                *len = u - utf16;
-                return utf16;
-            }
-
-            p++;
-
-            continue;
-        }
-
-        if (u + 1 == last) {
-            *len = u - utf16;
-            break;
-        }
-
-        n = ngx_utf8_decode(&p, 4);
-
-        if (n > 0x10ffff) {
-            ngx_set_errno(NGX_EILSEQ);
-            return NULL;
-        }
-
-        if (n > 0xffff) {
-            n -= 0x10000;
-            *u++ = (u_short) (0xd800 + (n >> 10));
-            *u++ = (u_short) (0xdc00 + (n & 0x03ff));
-            continue;
-        }
-
-        *u++ = (u_short) n;
-    }
-
-    /* the given buffer is not enough, allocate a new one */
-
-    u = malloc(((p - utf8) + ngx_strlen(p) + 1 + reserved) * sizeof(u_short));
-    if (u == NULL) {
-        return NULL;
-    }
-
-    ngx_memcpy(u, utf16, *len * 2);
-
-    utf16 = u;
-    u += *len;
-
-    for ( ;; ) {
-
-        if (*p < 0x80) {
-            *u++ = (u_short) *p;
-
-            if (*p == 0) {
-                *len = u - utf16;
-                return utf16;
-            }
-
-            p++;
-
-            continue;
-        }
-
-        n = ngx_utf8_decode(&p, 4);
-
-        if (n > 0x10ffff) {
-            ngx_free(utf16);
-            ngx_set_errno(NGX_EILSEQ);
-            return NULL;
-        }
-
-        if (n > 0xffff) {
-            n -= 0x10000;
-            *u++ = (u_short) (0xd800 + (n >> 10));
-            *u++ = (u_short) (0xdc00 + (n & 0x03ff));
-            continue;
-        }
-
-        *u++ = (u_short) n;
-    }
-
-    /* unreachable */
-}
