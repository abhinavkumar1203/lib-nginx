-            n = ngx_stream_regex_exec(s, sn[i].regex, host);
-
-            if (n == NGX_DECLINED) {
-                continue;
-            }
-
-            if (n == NGX_OK) {
-                *cscfp = sn[i].server;
-                return NGX_OK;
-            }
-
-            return NGX_ERROR;
-        }
-    }
-
-#endif /* NGX_PCRE */
-
-    return NGX_DECLINED;
-}
