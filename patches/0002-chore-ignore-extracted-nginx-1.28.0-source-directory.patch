-            if (p[0] == '*' && p[1] == ' ') {
-                p += 2;
-
-                while (p < b->last - 1) {
-                    if (p[0] == CR && p[1] == LF) {
-                        p += 2;
-                        break;
-                    }
-
-                    p++;
-                }
-
-                if (b->last - p < 4) {
-                    return NGX_AGAIN;
-                }
-            }
-
-            if (ngx_strncmp(p, s->tag.data, s->tag.len) == 0) {
-                p += s->tag.len;
-                if (p[0] == 'O' && p[1] == 'K') {
-                    return NGX_OK;
-                }
-            }
-
-            break;
-        }
-
-        break;
-
-    default: /* NGX_MAIL_SMTP_PROTOCOL */
-
-        if (p[3] == '-') {
-            /* multiline reply, check if we got last line */
-
-            m = b->last - (sizeof(CRLF "200" CRLF) - 1);
-
-            while (m > p) {
-                if (m[0] == CR && m[1] == LF) {
-                    break;
-                }
-
-                m--;
-            }
-
-            if (m <= p || m[5] == '-') {
-                return NGX_AGAIN;
-            }
