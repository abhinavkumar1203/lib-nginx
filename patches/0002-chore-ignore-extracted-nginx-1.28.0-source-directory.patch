-    n = writev(file->fd, vec->iovs, vec->count);
-
-    if (n == -1) {
-        err = ngx_errno;
-
-        if (err == NGX_EINTR) {
-            ngx_log_debug0(NGX_LOG_DEBUG_CORE, file->log, err,
