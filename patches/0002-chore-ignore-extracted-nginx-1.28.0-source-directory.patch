-    ngx_mail_ssl_conf_t       *sslcf;
-#endif
-    ngx_mail_core_srv_conf_t  *cscf;
-
-    if (ngx_mail_auth_http_escape(pool, &s->login, &login) != NGX_OK) {
-        return NULL;
-    }
-
-    if (ngx_mail_auth_http_escape(pool, &s->passwd, &passwd) != NGX_OK) {
-        return NULL;
