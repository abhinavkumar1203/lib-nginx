-
-        ngx_queue_insert_head(&r->name_expire_queue, &rn->queue);
-
-        ngx_resolver_free(r, rn->query);
-        rn->query = NULL;
-#if (NGX_HAVE_INET6)
-        rn->query6 = NULL;
-#endif
