-
-    if (mtx->spin == (ngx_uint_t) -1) {
-        return NGX_OK;
-    }
-
-    mtx->spin = 2048;
-
-#if (NGX_HAVE_POSIX_SEM)
-
-    mtx->wait = &addr->wait;
