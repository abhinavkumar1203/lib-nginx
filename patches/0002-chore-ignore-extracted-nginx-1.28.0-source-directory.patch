-        immedi=0x${ins:14:2}${ins:12:2}${ins:10:2}${ins:8:2} # int
-
-        dst="$(($srcdst & 0xF))"
-        src="$(($srcdst & 0xF0))"
-        src="$(($src >> 4))"
