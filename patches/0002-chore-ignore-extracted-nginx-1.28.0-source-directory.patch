-ngx_int_t
-ngx_stream_variables_init_vars(ngx_conf_t *cf)
-{
-    size_t                        len;
-    ngx_uint_t                    i, n;
-    ngx_hash_key_t               *key;
-    ngx_hash_init_t               hash;
-    ngx_stream_variable_t        *v, *av, *pv;
-    ngx_stream_core_main_conf_t  *cmcf;
