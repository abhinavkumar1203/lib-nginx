-                st->state = sw_type;
-                break;
-            }
-
-            switch (st->type) {
-
-            case NGX_HTTP_V3_FRAME_SETTINGS:
-                st->state = sw_settings;
-                break;
-
-            default:
-                ngx_log_debug0(NGX_LOG_DEBUG_HTTP, c->log, 0,
-                               "http3 parse skip unknown frame");
-                st->state = sw_skip;
-            }
-
-            break;
-
-        case sw_settings:
-
-            ngx_http_v3_parse_start_local(b, &loc, st->length);
-
