-
-        if (ngx_strcmp(value[i].data, "on") == 0) {
-            clcf->disable_symlinks = NGX_DISABLE_SYMLINKS_ON;
-            continue;
-        }
-
-        if (ngx_strncmp(value[i].data, "from=", 5) == 0) {
-            value[i].len -= 5;
-            value[i].data += 5;
-
-            ngx_memzero(&ccv, sizeof(ngx_http_compile_complex_value_t));
-
-            ccv.cf = cf;
-            ccv.value = &value[i];
