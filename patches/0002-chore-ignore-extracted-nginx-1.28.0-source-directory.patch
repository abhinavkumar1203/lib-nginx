-static ngx_int_t
-ngx_http_ssi_date_gmt_local_variable(ngx_http_request_t *r,
-    ngx_http_variable_value_t *v, uintptr_t gmt)
-{
-    time_t               now;
-    ngx_http_ssi_ctx_t  *ctx;
