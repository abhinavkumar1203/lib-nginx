-    if (conf->enable < NGX_HTTP_USERID_V1) {
-        v->not_found = 1;
-        return NGX_OK;
-    }
-
-    ctx = ngx_http_userid_get_uid(r->main, conf);
-
-    if (ctx == NULL) {
-        return NGX_ERROR;
-    }
-
-    if (ngx_http_userid_create_uid(r->main, ctx, conf) != NGX_OK) {
-        return NGX_ERROR;
-    }
-
-    if (ctx->uid_set[3] == 0) {
