-                        } else {
-                            b = ngx_calloc_buf(r->pool);
-                            if (b == NULL) {
-                                return NGX_ERROR;
-                            }
-
-                            cl = ngx_alloc_chain_link(r->pool);
-                            if (cl == NULL) {
-                                return NGX_ERROR;
-                            }
-
-                            cl->buf = b;
-                        }
-
-                        b->memory = 1;
-                        b->pos = ngx_http_ssi_string;
-                        b->last = ngx_http_ssi_string + ctx->saved;
-
-                        *ctx->last_out = cl;
-                        ctx->last_out = &cl->next;
-
-                        ctx->saved = 0;
