-            }
-
-            if (ctx->copy_start != ctx->copy_end) {
-
-                if (ctx->output) {
-
-                    ngx_log_debug1(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
-                                   "saved: %uz", ctx->saved);
-
-                    if (ctx->saved) {
-
-                        if (ctx->free) {
-                            cl = ctx->free;
-                            ctx->free = ctx->free->next;
-                            b = cl->buf;
-                            ngx_memzero(b, sizeof(ngx_buf_t));
