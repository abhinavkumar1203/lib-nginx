-
-    last = p + n;
-
-    for (len = 0; p < last; len++) {
-
-        c = *p;
-
-        if (c < 0x80) {
-            p++;
-            continue;
-        }
-
-        if (ngx_utf8_decode(&p, last - p) > 0x10ffff) {
-            /* invalid UTF-8 */
-            return n;
-        }
-    }
-
-    return len;
-}
