-
-ngx_chain_t *
-ngx_quic_copy_buffer(ngx_connection_t *c, u_char *data, size_t len)
-{
-    ngx_buf_t          buf;
-    ngx_chain_t        cl, *out;
-    ngx_quic_buffer_t  qb;
-
-    ngx_memzero(&buf, sizeof(ngx_buf_t));
-
-    buf.pos = data;
-    buf.last = buf.pos + len;
-    buf.temporary = 1;
-
-    cl.buf = &buf;
-    cl.next = NULL;
-
-    ngx_memzero(&qb, sizeof(ngx_quic_buffer_t));
-
-    if (ngx_quic_write_buffer(c, &qb, &cl, len, 0) == NGX_CHAIN_ERROR) {
-        return NGX_CHAIN_ERROR;
-    }
-
-    out = ngx_quic_read_buffer(c, &qb, len);
-    if (out == NGX_CHAIN_ERROR) {
-        return NGX_CHAIN_ERROR;
-    }
-
-    ngx_quic_free_buffer(c, &qb);
-
-    return out;
-}
-
-
-ngx_chain_t *
-ngx_quic_read_buffer(ngx_connection_t *c, ngx_quic_buffer_t *qb, uint64_t limit)
-{
-    uint64_t      n;
-    ngx_buf_t    *b;
-    ngx_chain_t  *out, **ll;
-
-    out = qb->chain;
-
-    for (ll = &out; *ll; ll = &(*ll)->next) {
-        b = (*ll)->buf;
-
-        if (b->sync) {
-            /* hole */
-            break;
-        }
-
-        if (limit == 0) {
-            break;
-        }
-
-        n = b->last - b->pos;
-
-        if (n > limit) {
-            if (ngx_quic_split_chain(c, *ll, limit) != NGX_OK) {
-                return NGX_CHAIN_ERROR;
-            }
-
-            n = limit;
-        }
-
-        limit -= n;
-        qb->offset += n;
-    }
-
-    if (qb->offset >= qb->last_offset) {
-        qb->last_chain = NULL;
-    }
-
-    qb->chain = *ll;
-    *ll = NULL;
-
-    return out;
-}
-
-
-void
-ngx_quic_skip_buffer(ngx_connection_t *c, ngx_quic_buffer_t *qb,
-    uint64_t offset)
-{
-    size_t        n;
-    ngx_buf_t    *b;
-    ngx_chain_t  *cl;
-
-    while (qb->chain) {
-        if (qb->offset >= offset) {
-            break;
-        }
-
-        cl = qb->chain;
-        b = cl->buf;
-        n = b->last - b->pos;
-
-        if (qb->offset + n > offset) {
-            n = offset - qb->offset;
-            b->pos += n;
-            qb->offset += n;
-            break;
-        }
-
-        qb->offset += n;
-        qb->chain = cl->next;
-
-        cl->next = NULL;
-        ngx_quic_free_chain(c, cl);
-    }
-
-    if (qb->chain == NULL) {
-        qb->offset = offset;
-    }
-
-    if (qb->offset >= qb->last_offset) {
-        qb->last_chain = NULL;
-    }
-}
