-        v->not_found = 1;
-
-        return NGX_OK;
-    }
-
-    cl = r->request_body->bufs;
-    buf = cl->buf;
-
-    if (cl->next == NULL) {
-        v->len = buf->last - buf->pos;
-        v->valid = 1;
-        v->no_cacheable = 0;
-        v->not_found = 0;
-        v->data = buf->pos;
-
-        return NGX_OK;
-    }
-
-    len = buf->last - buf->pos;
-    cl = cl->next;
-
-    for ( /* void */ ; cl; cl = cl->next) {
-        buf = cl->buf;
-        len += buf->last - buf->pos;
-    }
-
-    p = ngx_pnalloc(r->pool, len);
