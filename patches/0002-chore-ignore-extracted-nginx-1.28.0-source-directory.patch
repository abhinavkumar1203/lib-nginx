-        /* stop if there is nothing to send */
-
-        if (out == NULL) {
-            rc = NGX_AGAIN;
-            break;
-        }
-
-        do_write = 1;
-    }
-
-    if (!r->reading_body) {
-        if (!u->store && !r->post_action && !u->conf->ignore_client_abort) {
-            r->read_event_handler =
-                                  ngx_http_upstream_rd_check_broken_connection;
-        }
-    }
-
-    return rc;
-}
