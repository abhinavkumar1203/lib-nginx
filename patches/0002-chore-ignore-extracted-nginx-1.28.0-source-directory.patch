-void
-ngx_http_v3_cleanup_table(ngx_http_v3_session_t *h3c)
-{
-    ngx_uint_t                    n;
-    ngx_http_v3_dynamic_table_t  *dt;
-
-    dt = &h3c->table;
-
-    if (dt->elts == NULL) {
-        return;
-    }
-
-    for (n = 0; n < dt->nelts; n++) {
-        ngx_free(dt->elts[n]);
-    }
-
-    ngx_free(dt->elts);
-}
