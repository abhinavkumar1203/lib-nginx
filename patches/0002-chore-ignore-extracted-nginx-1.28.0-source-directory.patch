-
-    /* recursion query */
-    query->flags_hi = 1; query->flags_lo = 0;
-
-    /* one question */
-    query->nqs_hi = 0; query->nqs_lo = 1;
-    query->nan_hi = 0; query->nan_lo = 0;
-    query->nns_hi = 0; query->nns_lo = 0;
