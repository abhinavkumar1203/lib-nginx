-            rn = ngx_queue_data(q, ngx_resolver_node_t, queue);
-
-            if (rn->query) {
-                qident = (rn->query[0] << 8) + rn->query[1];
-
-                if (qident == ident) {
-                    goto dns_error_name;
-                }
-            }
-
-#if (NGX_HAVE_INET6)
-            if (rn->query6) {
-                qident6 = (rn->query6[0] << 8) + rn->query6[1];
