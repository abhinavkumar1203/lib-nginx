-
-failed:
-
-    if (ext->delete_file) {
-        if (ngx_delete_file(src->data) == NGX_FILE_ERROR) {
-            ngx_log_error(NGX_LOG_CRIT, ext->log, ngx_errno,
-                          ngx_delete_file_n " \"%s\" failed", src->data);
-        }
-    }
-
-    if (err) {
-        ngx_log_error(NGX_LOG_CRIT, ext->log, err,
