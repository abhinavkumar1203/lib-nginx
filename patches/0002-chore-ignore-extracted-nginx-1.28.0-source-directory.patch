-                    state = ssi_error_state;
-                }
-
-                ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
-                              "unexpected \"%c\" symbol before value of "
-                              "\"%V\" parameter in \"%V\" SSI command",
