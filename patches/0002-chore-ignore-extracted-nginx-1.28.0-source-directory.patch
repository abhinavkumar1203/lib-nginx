-        if (ngx_strcmp(value[i].data, "down") == 0) {
-
-            if (!(uscf->flags & NGX_STREAM_UPSTREAM_DOWN)) {
-                goto not_supported;
-            }
-
-            us->down = 1;
-
-            continue;
-        }
