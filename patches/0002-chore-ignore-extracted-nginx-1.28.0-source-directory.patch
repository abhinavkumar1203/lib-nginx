-
-static ngx_uint_t
-ngx_http_upstream_peek_random_peer(ngx_http_upstream_rr_peers_t *peers,
-    ngx_http_upstream_random_peer_data_t *rp)
-{
-    ngx_uint_t  i, j, k, x;
-
-    x = ngx_random() % peers->total_weight;
-
-    i = 0;
-    j = peers->number;
-
-    while (j - i > 1) {
-        k = (i + j) / 2;
-
-        if (x < rp->conf->ranges[k].range) {
-            j = k;
-
-        } else {
-            i = k;
-        }
-    }
-
-    return i;
-}
