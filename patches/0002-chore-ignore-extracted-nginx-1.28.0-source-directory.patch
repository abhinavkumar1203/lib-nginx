-static void *
-ngx_ssl_cache_cert_ref(char **err, void *data)
-{
-    int              n, i;
-    X509            *x509;
-    STACK_OF(X509)  *chain;
-
-    chain = sk_X509_dup(data);
-    if (chain == NULL) {
-        *err = "sk_X509_dup() failed";
-        return NULL;
-    }
-
-    n = sk_X509_num(chain);
-
-    for (i = 0; i < n; i++) {
-        x509 = sk_X509_value(chain, i);
-
-#if (OPENSSL_VERSION_NUMBER >= 0x10100000L)
-        X509_up_ref(x509);
-#else
-        CRYPTO_add(&x509->references, 1, CRYPTO_LOCK_X509);
-#endif
-    }
-
-    return chain;
-}
