-    ngx_memcpy(p, utf8, *len);
-
-    utf8 = p;
-    p += *len;
-
-    for ( ;; ) {
-
-        if (*u < 0x80) {
-            *p++ = (u_char) *u;
-
-            if (*u == 0) {
-                *len = p - utf8;
-                return utf8;
-            }
-
-            u++;
