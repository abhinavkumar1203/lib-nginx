-static void
-ngx_ssl_ocsp_dummy_handler(ngx_event_t *ev)
-{
-    ngx_log_debug0(NGX_LOG_DEBUG_EVENT, ev->log, 0,
-                   "ssl ocsp dummy handler");
-}
