-    if (ngx_strncmp(p, "sub ", 4) == 0
-        || ngx_strncmp(p, "sub{", 4) == 0
-        || ngx_strncmp(p, "use ", 4) == 0)
-    {
-        *sv = eval_pv((char *) p, FALSE);
-
-        /* eval_pv() does not set ERRSV on failure */
-
-        return;
-    }
-
-    *sv = NULL;
