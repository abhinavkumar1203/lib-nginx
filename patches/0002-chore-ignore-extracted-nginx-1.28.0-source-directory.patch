-
-    if (clcf->disable_symlinks == NGX_CONF_UNSET_UINT) {
-        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
-                           "\"%V\" must have \"off\", \"on\" "
-                           "or \"if_not_owner\" parameter",
