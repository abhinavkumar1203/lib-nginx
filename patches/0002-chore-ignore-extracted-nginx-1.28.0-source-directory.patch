-static void
-ngx_ssl_stapling_cleanup(void *data)
-{
-    ngx_ssl_stapling_t  *staple = data;
-
-    if (staple->issuer) {
-        X509_free(staple->issuer);
-    }
-
-    if (staple->staple.data) {
-        ngx_free(staple->staple.data);
-    }
-}
