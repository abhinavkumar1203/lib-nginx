-    /*
-     * generic phase checker,
-     * used by the post read and pre-access phases
-     */
-
-    ngx_log_debug1(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
-                   "generic phase: %ui", r->phase_handler);
-
-    rc = ph->handler(r);
-
-    if (rc == NGX_OK) {
-        r->phase_handler = ph->next;
-        return NGX_AGAIN;
