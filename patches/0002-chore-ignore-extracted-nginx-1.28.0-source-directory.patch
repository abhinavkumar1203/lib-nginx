-static ngx_int_t
-ngx_http_v3_parse_encoder(ngx_connection_t *c, ngx_http_v3_parse_encoder_t *st,
-    ngx_buf_t *b)
-{
-    u_char     ch;
-    ngx_int_t  rc;
-    enum {
-        sw_start = 0,
-        sw_inr,
-        sw_iln,
-        sw_capacity,
-        sw_duplicate
-    };
