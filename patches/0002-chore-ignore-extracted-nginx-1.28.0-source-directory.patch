-
-size_t
-ngx_quic_create_retry_itag(ngx_quic_header_t *pkt, u_char *out,
-    u_char **start)
-{
-    u_char  *p;
-
-    p = out;
-
-    *p++ = pkt->odcid.len;
-    p = ngx_cpymem(p, pkt->odcid.data, pkt->odcid.len);
-
-    *start = p;
-
-    *p++ = 0xff;
-
-    p = ngx_quic_write_uint32(p, pkt->version);
-
-    *p++ = pkt->dcid.len;
-    p = ngx_cpymem(p, pkt->dcid.data, pkt->dcid.len);
-
-    *p++ = pkt->scid.len;
