-
-static ngx_int_t
-ngx_http_v3_parse_field_lri(ngx_connection_t *c,
-    ngx_http_v3_parse_field_t *st, ngx_buf_t *b)
-{
-    u_char     ch;
-    ngx_int_t  rc;
-    enum {
-        sw_start = 0,
-        sw_index,
-        sw_value_len,
-        sw_read_value_len,
