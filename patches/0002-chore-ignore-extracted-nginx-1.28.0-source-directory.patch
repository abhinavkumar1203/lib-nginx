-
-    index -= NGX_HTTP_V2_STATIC_TABLE_ENTRIES;
-
-    if (index < h2c->hpack.added - h2c->hpack.deleted) {
-        index = (h2c->hpack.added - index - 1) % h2c->hpack.allocated;
